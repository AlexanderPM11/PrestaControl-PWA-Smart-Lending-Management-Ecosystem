# Database
MYSQL_ROOT_PASSWORD=change-this-password
MYSQL_DATABASE=prestacontrol_db

# Telegram bot secrets/configuration
# Generate the token with @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# Chat ID that receives password-recovery messages.
TELEGRAM_ADMIN_CHAT_ID=replace-with-your-telegram-chat-id

# Leave the frontend API URL unset for the Docker deployment: the PWA uses
# the same-origin /api route and Nginx forwards it to the internal api service.
VITE_API_URL=/api

# Internal encrypted full backup to Google Drive (backend only)
BACKUP_ENABLED=false
BACKUP_RUN_ON_STARTUP=false
BACKUP_TIME=03:00
BACKUP_TIME_ZONE=America/Santo_Domingo
# Set > 0 to use a fixed interval instead of BACKUP_TIME.
BACKUP_INTERVAL_HOURS=0
BACKUP_RETENTION_DAYS=90
BACKUP_GOOGLE_DRIVE_FOLDER_ID=replace-with-drive-folder-id
# OAuth for a folder in My Drive (recommended for the folder shown in Drive).
BACKUP_GOOGLE_CLIENT_ID=replace-with-oauth-client-id
BACKUP_GOOGLE_CLIENT_SECRET=replace-with-oauth-client-secret
BACKUP_GOOGLE_REFRESH_TOKEN=replace-with-oauth-refresh-token
BACKUP_GOOGLE_REDIRECT_URI=https://your-domain.com/api/backups/google/callback
# Required: archives contain database, environment variables and app files.
BACKUP_ENCRYPTION_PASSWORD=replace-with-a-long-backup-password
# Optional overrides; defaults use the Compose MySQL service.
BACKUP_DB_HOST=db
BACKUP_DB_PORT=3306
BACKUP_DB_USER=root
BACKUP_DB_PASSWORD=
BACKUP_DB_NAME=
# Host folder mounted read-only; include Compose/.env/service-account here when desired.
BACKUP_SOURCE_PATH=.
